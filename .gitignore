# Unity caches, builds and local diagnostics
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]in/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
sysinfo.txt
crashlytics-build.properties

# Unity-generated IDE projects (root only; Standalone projects are hand-written)
/*.csproj
/*.unityproj
/*.sln
/*.slnx
*.booproj
/.idea/
/.vs/
/.vscode/
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.svd
*.pdb
*.mdb
*.mdb.meta
*.opendb
*.VC.db

# Standalone .NET build intermediates and outputs, not source
/Standalone/**/[Bb]in/
/Standalone/**/[Oo]bj/

# OS files
.DS_Store
Thumbs.db

# Build/export artifacts (keep Android templates and plugin binaries)
ExportedObj/
*.apk
*.aab
*.unitypackage
*.app/

# Generated Addressables build data; keep other StreamingAssets and their metadata
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/

# Local SDK credentials and Android signing keys.
# Keep the tracked LocalSettings.meta folder GUID; ignore the payload inside.
/Assets/Resources/LocalSettings/
/LocalSafe/
*.keystore
*.jks

# Local Locus integration and generated analyzer config with machine-specific paths
/Packages/com.farlocus.locus/
/Directory.Build.props

# Share project knowledge (including .locus-meta); keep other Locus data local
/Locus/*
!/Locus/knowledge/